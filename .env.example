# Copy to .env (never commit .env). All values are placeholders.
# Secret used to sign/verify license keys (owner generates: openssl rand -hex 32)
LICENSE_SIGNING_SECRET=changeme
# Stripe (leave unset to stay in dry-run mode)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ORG=
CHECKOUT_SUCCESS_URL=https://example.com/thanks
CHECKOUT_CANCEL_URL=https://example.com/pricing
# Live checkout calls stay blocked unless this is "true" AND a human approval exists
ALLOW_LIVE_CHECKOUT=false
# Where audit and approval logs are written
LEDGER_PATH=./ledger/decisions.jsonl
APPROVALS_PATH=./ledger/approvals.jsonl
# Stripe webhook signing secret (whsec_...) for code/commercial/webhook.js; unset = every webhook is rejected
STRIPE_WEBHOOK_SECRET=
# Webhook license store (hashes + pending plaintext outbox; protect like a secret store). FAIL CLOSED: if neither is set the webhook returns 503 and FZ- keys are denied.
# Option A, one server with a persistent disk (Node >= 22.5): SQLite file, keep under ledger/ (gitignored)
LICENSE_DB=./ledger/licenses.sqlite
# Option B, serverless / multi-instance (needs `pg` installed in the host app); wins over LICENSE_DB when set
# LICENSE_DATABASE_URL=postgres://user:password@host:5432/dbname
# LICENSE_DATABASE_SSL=require
# LICENSE_DB_POOL_MAX=5
